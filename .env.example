# Turing Tarpit – environment variables
# Copy to .env and adjust

# Server
TT_HOST=0.0.0.0
TT_PORT=8080
TT_GRPC_PORT=50051

# Database
DATABASE_URL=postgres://turing:turing@localhost:5432/turing_tarpit
REDIS_URL=redis://localhost:6379

# Search
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=turing-dev-master-key-change-me

# Object storage (S3-compatible / RustFS)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=turing
S3_SECRET_KEY=turingsecret
S3_BUCKET=turing-tarpit
S3_REGION=us-east-1

# ClickHouse (optional in v1)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=turing_tarpit

# Auth
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:8080
WEBAUTHN_RP_NAME="Turing Tarpit"

# Git
GIT_REPOS_ROOT=/var/lib/turing-tarpit/repos

# Realtime backend: "redis" | "in_memory" | "iggy" (future)
REALTIME_BACKEND=redis

# Logging
RUST_LOG=info,tt_server=debug,tt_messaging=debug


# Session PASETO v4.local key (32 random bytes, hex-encoded). Generate with:
#   openssl rand -hex 32
SESSION_KEY=
SESSION_TTL_HOURS=168
